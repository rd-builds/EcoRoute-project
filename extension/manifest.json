{
  "manifest_version": 3,
  "name": "EcoRoute",
  "version": "1.0.0",
  "description": "EcoRoute optimizes ChatGPT prompts to reduce unnecessary tokens and compute while preserving the user's intent.",

  "permissions": [
    "clipboardWrite"
  ],

  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "services/api.js",
        "services/metrics.js",
        "services/text-optimizer.js",
        "adapters/chatgpt.js",
        "ui/analysis-panel.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}